.container-fluid
  .card
    .card-header.d-flex.justify-content-between.align-items-center
      %span.fw-semibold Users
      = link_to "Add New User", new_user_path, class: "btn btn-primary btn-sm"
    .card-body.p-0
      .table-responsive
        %table.table.table-striped.align-middle.mb-0
          %thead
            %tr
              %th Name
              %th Email
              %th Role
              %th Status
          %tbody
            - @users.each do |user|
              %tr{style: "cursor: pointer;", onclick: "window.location='#{user_path(user["id"])}'"}
                %td= "#{user["last_name"]}, #{user["first_name"]}"
                %td= user["email"]
                %td= user["role"]
                %td= user["status"]
