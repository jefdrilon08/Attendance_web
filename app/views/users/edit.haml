.container-fluid{style: "max-width: 700px;"}
  .card
    .card-header
      %span.fw-semibold Edit User
    .card-body
      = form_with url: user_path(@user["id"]), scope: :user, method: :patch, local: true do |f|
        .mb-3
          = f.label :email, class: "form-label"
          = f.email_field :email, class: "form-control", value: @user["email"], required: true
        .row
          .col.mb-3
            = f.label :first_name, class: "form-label"
            = f.text_field :first_name, class: "form-control", value: @user["first_name"], required: true
          .col.mb-3
            = f.label :last_name, class: "form-label"
            = f.text_field :last_name, class: "form-control", value: @user["last_name"], required: true
        .mb-3
          = f.label :middle_name, class: "form-label"
          = f.text_field :middle_name, class: "form-control", value: @user["middle_name"]
        .mb-3
          = f.label :position_id, class: "form-label"
          = f.select :position_id, @positions.map { |p| [p["name"], p["id"]] }, { prompt: "Select position", selected: @user["position_id"] }, class: "form-select"
        .mb-3
          = f.label :role, class: "form-label"
          = f.select :role, ["employee", "manager", "hr", "admin"], { selected: @user["role"] }, class: "form-select"
        .mb-3
          = f.label :status, class: "form-label"
          = f.select :status, ["active", "inactive"], { selected: @user["status"] }, class: "form-select"
        = f.submit "Update User", class: "btn btn-primary"
