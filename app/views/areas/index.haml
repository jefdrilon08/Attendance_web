.container-fluid
  .card
    .card-header.d-flex.justify-content-between.align-items-center
      %span.fw-semibold Areas
      = link_to "Add New Area", new_area_path, class: "btn btn-primary btn-sm"
    .card-body.p-0
      .table-responsive
        %table.table.table-striped.align-middle.mb-0
          %thead
            %tr
              %th Name
              %th Code
              %th Approver
              %th
          %tbody
            - @areas.each do |area|
              %tr
                %td= area["name"]
                %td= area["code"]
                %td= area["approver_name"] || "—"
                %td= link_to "Edit", edit_area_path(area["id"]), class: "btn btn-sm btn-outline-secondary"
