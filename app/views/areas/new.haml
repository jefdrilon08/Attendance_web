.container-fluid{style: "max-width: 600px;"}
  .card
    .card-header
      %span.fw-semibold Add New Area
    .card-body
      = form_with url: areas_path, scope: :area, method: :post, local: true do |f|
        .mb-3
          = f.label :name, class: "form-label"
          = f.text_field :name, class: "form-control", required: true
        .mb-3
          = f.label :code, class: "form-label"
          = f.text_field :code, class: "form-control"
        .mb-3
          = f.label :approver_id, "Approver", class: "form-label"
          = f.select :approver_id, @users.map { |u| ["#{u["last_name"]}, #{u["first_name"]}", u["id"]] }, { prompt: "Select approver (optional)" }, class: "form-select"
        = f.submit "Create Area", class: "btn btn-primary"
