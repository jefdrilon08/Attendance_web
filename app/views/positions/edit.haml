.container-fluid{style: "max-width: 600px;"}
  .card
    .card-header
      %span.fw-semibold Edit Position
    .card-body
      = form_with url: position_path(@position["id"]), scope: :position, method: :patch, local: true do |f|
        .mb-3
          = f.label :name, class: "form-label"
          = f.text_field :name, class: "form-control", value: @position["name"], required: true
        .mb-3
          = f.label :organization_structure_id, "Organization Structure", class: "form-label"
          = f.select :organization_structure_id, @organization_structures.map { |o| [o["name"], o["id"]] }, { prompt: "Select structure (optional)", selected: @position["organization_structure_id"] }, class: "form-select"
        = f.submit "Update Position", class: "btn btn-primary"
