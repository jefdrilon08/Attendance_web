.container-fluid
  .card
    .card-header.d-flex.justify-content-between.align-items-center
      %span.fw-semibold Positions
      = link_to "Add New Position", new_position_path, class: "btn btn-primary btn-sm"
    .card-body.p-0
      .table-responsive
        %table.table.table-striped.align-middle.mb-0
          %thead
            %tr
              %th Name
              %th Organization Structure
              %th
          %tbody
            - @positions.each do |position|
              %tr
                %td= position["name"]
                %td= position["organization_structure_name"] || "—"
                %td= link_to "Edit", edit_position_path(position["id"]), class: "btn btn-sm btn-outline-secondary"
