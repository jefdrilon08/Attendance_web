.container-fluid{style: "max-width: 600px;"}
  .card
    .card-header
      %span.fw-semibold Add New Leave Type
    .card-body
      = form_with url: leave_types_path, scope: :leave_type, method: :post, local: true do |f|
        .mb-3
          = f.label :name, class: "form-label"
          = f.text_field :name, class: "form-control", required: true
        .mb-3
          = f.label :code, class: "form-label"
          = f.text_field :code, class: "form-control", required: true
        .mb-3
          = f.label :max_days_per_year, "Max Days Per Year", class: "form-label"
          = f.number_field :max_days_per_year, class: "form-control", step: "0.5"
        = f.submit "Create Leave Type", class: "btn btn-primary"
