.container-fluid
  .card
    .card-header.d-flex.justify-content-between.align-items-center
      %span.fw-semibold Leave Types
      = link_to "Add New Leave Type", new_leave_type_path, class: "btn btn-primary btn-sm"
    .card-body.p-0
      .table-responsive
        %table.table.table-striped.align-middle.mb-0
          %thead
            %tr
              %th Name
              %th Code
              %th Max Days / Year
              %th
          %tbody
            - @leave_types.each do |lt|
              %tr
                %td= lt["name"]
                %td= lt["code"]
                %td= lt["max_days_per_year"]
                %td= link_to "Edit", edit_leave_type_path(lt["id"]), class: "btn btn-sm btn-outline-secondary"
