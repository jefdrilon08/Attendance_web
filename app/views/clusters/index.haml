.container-fluid
  .card
    .card-header.d-flex.justify-content-between.align-items-center
      %span.fw-semibold Clusters
      = link_to "Add New Cluster", new_cluster_path, class: "btn btn-primary btn-sm"
    .card-body.p-0
      .table-responsive
        %table.table.table-striped.align-middle.mb-0
          %thead
            %tr
              %th Name
              %th Area
              %th Approver
              %th
          %tbody
            - @clusters.each do |cluster|
              %tr{style: "cursor: pointer;", onclick: "window.location='#{cluster_path(cluster["id"])}'"}
                %td= cluster["name"]
                %td= cluster["area_name"] || "—"
                %td= cluster["approver_name"] || "—"
                %td= link_to "Edit", edit_cluster_path(cluster["id"]), class: "btn btn-sm btn-outline-secondary"
