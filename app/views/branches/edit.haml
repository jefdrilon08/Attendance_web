.container-fluid{style: "max-width: 600px;"}
  .card
    .card-header
      %span.fw-semibold Edit Branch
    .card-body
      = form_with url: branch_path(@branch["id"]), scope: :branch, method: :patch, local: true do |f|
        .mb-3
          = f.label :name, class: "form-label"
          = f.text_field :name, class: "form-control", value: @branch["name"], required: true
        .mb-3
          = f.label :short_code, class: "form-label"
          = f.text_field :short_code, class: "form-control", value: @branch["short_code"]
        .row
          .col.mb-3
            = f.label :latitude, class: "form-label"
            = f.text_field :latitude, class: "form-control", value: @branch["latitude"]
          .col.mb-3
            = f.label :longitude, class: "form-label"
            = f.text_field :longitude, class: "form-control", value: @branch["longitude"]
        .mb-3
          = f.label :allowed_radius, "Allowed Radius (meters)", class: "form-label"
          = f.number_field :allowed_radius, class: "form-control", value: @branch["allowed_radius"]
        .mb-3
          = f.label :cluster_id, "Cluster", class: "form-label"
          = f.select :cluster_id, @clusters.map { |c| [c["name"], c["id"]] }, { prompt: "Select cluster (optional)", selected: @branch["cluster_id"] }, class: "form-select"
        .mb-3
          = f.label :approver_id, "Approver", class: "form-label"
          = f.select :approver_id, @users.map { |u| ["#{u["last_name"]}, #{u["first_name"]}", u["id"]] }, { prompt: "Select approver (optional)", selected: @branch["approver_id"] }, class: "form-select"
        = f.submit "Update Branch", class: "btn btn-primary"
